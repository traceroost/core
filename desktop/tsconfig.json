{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "../src/serviceConfig.ts", "../src/portResolver.ts", "../standalone/dataDirLock.ts"],
  "//exclude": "The tests are compiled by the repo root's tsconfig.test.desktop.json, which has the mocha types and the same strictness; checking them here as well would need a second copy of those types in this package.",
  "exclude": ["src/**/*.test.ts"]
}
