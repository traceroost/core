# NOTE: package.json's `files` allowlist decides what the npm tarball contains, and npm ignores
# this root .npmignore while `files` is set (walkthrough/ below ships anyway — the extension
# manifest points at it). Kept only in case `files` is ever removed. Verify the tarball with:
#   npm pack --dry-run --ignore-scripts

# README-only media
media/demo.gif

# Dev tooling
.vscode/**
.vscode-test/**
.github/**
.staged-issues/**
.staged-features/**
demo/**
src/**
media/src/**
walkthrough/**
out/**

# Test artifacts
src/test/**
*.test.ts

# Config / lockfiles
.gitignore
.vscodeignore
.yarnrc
.mocharc.cjs
esbuild.js
pnpm-lock.yaml
**/tsconfig.json
**/tsconfig.test.json
**/eslint.config.mjs

# Source maps and TypeScript source
**/*.map
**/*.ts
**/.vscode-test.*
vsce-identity.json
