# Copy to `.env` to control which TraceRoost Pro environment `npm run local` points at.
# `.env` is gitignored — safe to leave your personal choice in it.

# One of: production (default), stage, test
# TRACEROOST_TEAM_ENV=test

# Or point at an exact URL instead (e.g. alsaas's own `pnpm dev` on localhost) — this wins
# over TRACEROOST_TEAM_ENV when set.
# TRACEROOST_TEAM_URL=http://localhost:3000
