# Copy to `.env` to control which TraceRoost Cloud environment `pnpm run local` points at.
# `.env` is gitignored — safe to leave your personal choice in it.

# One of: stage (default), production, test
# TRACEROOST_ORG_ENV=test

# Or point at an exact URL instead (e.g. alsaas's own `pnpm dev` on localhost) — this wins
# over TRACEROOST_ORG_ENV when set.
# TRACEROOST_ORG_URL=http://localhost:3000
